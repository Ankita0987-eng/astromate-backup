# Copy to .env and fill in your keys (never commit .env)

# AI Chat — Groq (FREE: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key

# OpenAI (optional — Groq is used by default)
OPENAI_API_KEY=sk-your-openai-key
ASTROLOGY_API_USER_ID=your_astrologyapi_user_id
ASTROLOGY_API_KEY=your_astrologyapi_key
ASTROLOGY_API_BASE_URL=https://json.astrologyapi.com/v1

# Google Mobile Ads (test IDs shown — replace for production)
ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917
ADMOB_NATIVE_ID=ca-app-pub-3940256099942544/2247696110

# In-App Purchase product IDs (configure in Play Console)
IAP_MONTHLY_ID=cosmic_match_premium_monthly
IAP_YEARLY_ID=cosmic_match_premium_yearly

# Google Places API (New)
GOOGLE_PLACES_API_KEY=your_google_places_api_key
# Optional: Android SHA1 certificate fingerprint (without colons, e.g. 1A2B3C4D...)
ANDROID_SHA1_FINGERPRINT=

